# ADMIN_TOKEN=your_admin_token_here
# CLIENT_URL=http://localhost:3000
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_FOLDER=anli-assets
# CLOUDINARY_SIGNED_PRESET=your_signed_preset
# For MongoDB Atlas SRV URIs, omit the port and use a dedicated non-production DB name.
# DB_URL=mongodb+srv://username:password@your-cluster.mongodb.net/bakery_dev?retryWrites=true&w=majority
# EMAIL_PASS=your_email_password
# JWT_EXPIRY=7d
# JWT_SECRET=your_jwt_secret_here
# PORT=5656
# BOOTSTRAP_SECRET=replace_with_secure_random_value
# Website communications (configure in the server environment; never commit real values)
# BAKERY_API_URL is configured by the storefront project and should point to this server.
# PUBLIC_STOREFRONT_URL=https://www.example-bakery.com
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_FROM_INFO=The SourDough Bakery <info@example-bakery.com>
# RESEND_FROM_ORDERS=The SourDough Bakery <orders@example-bakery.com>
# RESEND_FROM_SALES=The SourDough Bakery <sales@example-bakery.com>
# RESEND_FROM_NEWSLETTER=The SourDough Bakery <news@example-bakery.com>
# RESEND_NEWSLETTER_SEGMENT_ID=your_resend_segment_id
# NEWSLETTER_TOKEN_SECRET=replace_with_a_long_random_secret
